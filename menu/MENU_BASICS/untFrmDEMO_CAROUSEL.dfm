          '    difference = mouseX - initX;'
          ''
          ''
          
            '    //$('#39'.slider_inner__slide'#39').css('#39'transform'#39', '#39'rotateY('#39' + di' +
            'rection + pps / 110 + '#39'deg) scale(1)'#39')'
          
            '    position = parseInt($('#39'.slider_inner'#39').css('#39'transform'#39').spli' +
