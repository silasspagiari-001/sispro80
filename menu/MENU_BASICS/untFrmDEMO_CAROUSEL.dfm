          ''
          '// https://gist.github.com/ripper234/5757309'
          ''
          'function drawMouseSpeedDemo() {'
          '  var mrefreshinterval = 30; // update display every 500ms'
          '  var lastmousex = -1;'
          '  var lastmousey = -1;'
          '  var lastmousetime;'
          '  var mousetravel = 0;'
          '  var mpoints = [];'
          '  var mpoints_max = 30;'
          '  var direction;'
          ''
          '  $('#39'html'#39').mousemove(function (e) {'
          '    var mousex = e.pageX;'
          '    var mousey = e.pageY;'
          '    if (lastmousex > -1) {'
          
            '      mousetravel += Math.max(Math.abs(mousex - lastmousex), Mat' +
            'h.abs(mousey - lastmousey));'
          '    }'
          '    // console.log(mousex-lastmousex)'
          ''
          '    if (mousex - lastmousex > 0) {'
          '      direction = '#39'+'#39';'
          '    } else {'
          '      direction = '#39'-'#39';'
          '    }'
          ''
          '    //console.log(direction);'
          ''
          '    lastmousex = mousex;'
          '    lastmousey = mousey;'
          '  });'
          '  var mdraw = function () {'
          '    var md = new Date();'
          '    var timenow = md.getTime();'
          '    if (lastmousetime && lastmousetime != timenow) {'
          
            '      var pps = Math.round(mousetravel / (timenow - lastmousetim' +
            'e) * 1000);'
          '      mpoints.push(pps);'
          '      if (mpoints.length > mpoints_max)'
          '      mpoints.splice(0, 1);'
          '      mousetravel = 0;'
          '      //console.log(pps)'
          '      if (dragging) {'
          '        let velocity = .5 - pps / 40000;'
          ''
          ''
          ''
          
            '        $('#39'.slider_inner__slide'#39').css('#39'transform'#39', '#39'rotateY('#39' + ' +
            'direction + pps / 110 + '#39'deg) scale(1)'#39');'
          
            '        $('#39'.slider_inner__slide'#39').css('#39'transition'#39', '#39'all '#39' + vel' +
            'ocity + '#39's'#39');'
          '        //console.log(velocity)'
          '      }'
          ''
          '    }'
          '    lastmousetime = timenow;'
          '    setTimeout(mdraw, mrefreshinterval);'
          '  };'
          
            '  // We could use setInterval instead, but I prefer to do it thi' +
            's way'
          '  setTimeout(mdraw, mrefreshinterval);'
          '};'
          ''
          'drawMouseSpeedDemo();'
          ''
          '/* -------------------------------------------------'
          ''
          'Dynamic cursor'
          ''
          '--------------------------------------------------- */'
          ''
          'const cursorSettings = {'
          '  '#39'class'#39': '#39'dynamicCursor'#39','
          '  '#39'size'#39': '#39'18'#39','
          '  '#39'expandedSize'#39': '#39'40'#39','
          '  '#39'expandSpeed'#39': 0.4,'
          '  '#39'background'#39': '#39'rgba(161, 142, 218, 0.25)'#39','
          '  '#39'opacity'#39': '#39'1'#39','
          '  '#39'transitionTime'#39': '#39'1.4s'#39','
          '  '#39'transitionEase'#39': '#39'cubic-bezier(0.075, 0.820, 0.165, 1.000)'#39','
          '  '#39'borderWidth'#39': '#39'0'#39','
          '  '#39'borderColor'#39': '#39'black'#39','
          '  '#39'iconSize'#39': '#39'11px'#39','
          '  '#39'iconColor'#39': '#39'white'#39','
          '  '#39'triggerElements'#39': {'
          '    '#39'trigger'#39': {'
