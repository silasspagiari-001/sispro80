            '  $('#39'.slider_inner__slide'#39').css('#39'transform'#39', '#39'rotateY(0deg) scal' +
            'e(1)'#39');'
          '});'
          '$('#39'.slider_inner'#39').mousedown(function (e) {'
          '  initX = e.clientX;'
          '  dragging = true;'
          '  //$('#39'.slider_inner__slide'#39').css('#39'animation'#39', '#39'none'#39')'
          '  cursor.style.transition = `transform 0s 0s`;'
          ''
          '  console.log(cursor);'
