            '+ '#39') .image .overlay, .slider_inner__slide:nth-of-type('#39' + parse' +
            'Int(index + 1) + '#39') .image .title, .slider_inner__slide:nth-of-t' +
            'ype('#39' + parseInt(index + 1) + '#39') .image .cats, .slider_inner__sl' +
