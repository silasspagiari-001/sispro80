          '        endPosition = threshold;'
          ''
          '      } else {'
          '        var threshold = offset - (offset + margin) * index;'
          
            '        $('#39'.slider_inner'#39').css('#39'transform'#39', `translateX(${thresh' +
            'old}px) translateY(120px)`);'
          '        endPosition = threshold;'
          ''
          '      }'
          ''
          '    } else {'
          '      var threshold = offset - (offset + margin) * index;'
          
            '      $('#39'.slider_inner'#39').css('#39'transform'#39', `translateX(${threshol' +
            'd}px) translateY(120px)`);'
          '      endPosition = threshold;'
          ''
          '    }'
          '  }'
          ''
          '  dragging = false;'
          
            '  console.log('#39'.slider_inner__slide:nth-of-type('#39' + parseInt(ind' +
            'ex + 1) + '#39')'#39');'
          
            '  $('#39'.slider_inner__slide:nth-of-type('#39' + parseInt(index + 1) + ' +
            #39') .image .overlay, .slider_inner__slide:nth-of-type('#39' + parseIn' +
            't(index + 1) + '#39') .image .title, .slider_inner__slide:nth-of-typ' +
            'e('#39' + parseInt(index + 1) + '#39') .image .cats, .slider_inner__slid' +
            'e:nth-of-type('#39' + parseInt(index + 1) + '#39') .image .button'#39').css(' +
            #39'opacity'#39', 1);'
          
            '  $('#39'.slider_inner__slide'#39').css('#39'transform'#39', '#39'rotateY(0deg) scal' +
            'e(1)'#39');'
          '  $('#39'.slideClone'#39').hide();'
          
            '  $('#39'.slideClone:nth-of-type('#39' + parseInt(index + 2) + '#39')'#39').show' +
            '();'
          '  difference = 0;'
          '});'
          ''
          '// https://gist.github.com/ripper234/5757309'
          ''
          'function drawMouseSpeedDemo() {'
          '  var mrefreshinterval = 30; // update display every 500ms'
          '  var lastmousex = -1;'
          '  var lastmousey = -1;'
          '  var lastmousetime;'
          '  var mousetravel = 0;'
          '  var mpoints = [];'
          '  var mpoints_max = 30;'
          '  var direction;'
          ''
          '  $('#39'html'#39').mousemove(function (e) {'
          '    var mousex = e.pageX;'
          '    var mousey = e.pageY;'
          '    if (lastmousex > -1) {'
          
            '      mousetravel += Math.max(Math.abs(mousex - lastmousex), Mat' +
            'h.abs(mousey - lastmousey));'
          '    }'
          '    // console.log(mousex-lastmousex)'
          ''
          '    if (mousex - lastmousex > 0) {'
          '      direction = '#39'+'#39';'
          '    } else {'
          '      direction = '#39'-'#39';'
          '    }'
          ''
          '    //console.log(direction);'
          ''
          '    lastmousex = mousex;'
          '    lastmousey = mousey;'
          '  });'
          '  var mdraw = function () {'
          '    var md = new Date();'
          '    var timenow = md.getTime();'
          '    if (lastmousetime && lastmousetime != timenow) {'
          
            '      var pps = Math.round(mousetravel / (timenow - lastmousetim' +
            'e) * 1000);'
          '      mpoints.push(pps);'
          '      if (mpoints.length > mpoints_max)'
          '      mpoints.splice(0, 1);'
          '      mousetravel = 0;'
          '      //console.log(pps)'
          '      if (dragging) {'
          '        let velocity = .5 - pps / 40000;'
          ''
          ''
          ''
          
            '        $('#39'.slider_inner__slide'#39').css('#39'transform'#39', '#39'rotateY('#39' + ' +
            'direction + pps / 110 + '#39'deg) scale(1)'#39');'
          
            '        $('#39'.slider_inner__slide'#39').css('#39'transition'#39', '#39'all '#39' + vel' +
            'ocity + '#39's'#39');'
          '        //console.log(velocity)'
          '      }'
          ''
          '    }'
          '    lastmousetime = timenow;'
          '    setTimeout(mdraw, mrefreshinterval);'
          '  };'
          
            '  // We could use setInterval instead, but I prefer to do it thi' +
            's way'
          '  setTimeout(mdraw, mrefreshinterval);'
          '};'
          ''
          'drawMouseSpeedDemo();'
          ''
          '/* -------------------------------------------------'
          ''
          'Dynamic cursor'
          ''
          '--------------------------------------------------- */'
          ''
          'const cursorSettings = {'
          '  '#39'class'#39': '#39'dynamicCursor'#39','
          '  '#39'size'#39': '#39'18'#39','
          '  '#39'expandedSize'#39': '#39'40'#39','
          '  '#39'expandSpeed'#39': 0.4,'
          '  '#39'background'#39': '#39'rgba(161, 142, 218, 0.25)'#39','
          '  '#39'opacity'#39': '#39'1'#39','
          '  '#39'transitionTime'#39': '#39'1.4s'#39','
          '  '#39'transitionEase'#39': '#39'cubic-bezier(0.075, 0.820, 0.165, 1.000)'#39','
          '  '#39'borderWidth'#39': '#39'0'#39','
          '  '#39'borderColor'#39': '#39'black'#39','
          '  '#39'iconSize'#39': '#39'11px'#39','
          '  '#39'iconColor'#39': '#39'white'#39','
          '  '#39'triggerElements'#39': {'
          '    '#39'trigger'#39': {'
          '      '#39'className'#39': '#39'trigger'#39','
          '      '#39'icon'#39': '#39'<i class="fa fa-plus"></i>'#39' },'
          ''
          '    '#39'trigger2'#39': {'
          '      '#39'className'#39': '#39'slider_inner'#39','
          '      '#39'icon'#39': '#39'<i class="fa fa-arrows-h"></i>'#39' } } };'
          ''
          ''
          ''
          ''
          ''
          'function dynamicCursor(options) {'
          ''
          
            '  document.write('#39'<link rel="stylesheet" href="https://maxcdn.ic' +
            'ons8.com/fonts/line-awesome/1.1/css/line-awesome-font-awesome.mi' +
            'n.css">'#39');'
          ''
          '  var hold;'
          '  cursor = document.createElement('#39'div'#39');'
          '  let cursorIcon = document.createElement('#39'div'#39');'
          ''
          '  cursorIcon.classList.add('#39'cursorIcon'#39');'
          '  cursorIcon.style.position = '#39'absolute'#39';'
          '  cursorIcon.style.fontFamily = '#39'Raleway'#39';'
          '  cursorIcon.style.textTransform = '#39'uppercase'#39';'
          '  cursorIcon.style.fontWeight = '#39'800'#39';'
          '  cursorIcon.style.textAlign = '#39'center'#39';'
          '  cursorIcon.style.top = '#39'50%'#39';'
          '  cursorIcon.style.width = '#39'100%'#39';'
          '  cursorIcon.style.transform = '#39'translateY(-50%)'#39';'
          '  cursorIcon.style.color = options.iconColor;'
          '  cursorIcon.style.fontSize = options.iconSize;'
          '  cursorIcon.style.opacity = 0;'
          
            '  cursorIcon.style.transition = `opacity ${options.expandSpeed}s' +
            '`;'
          ''
          '  cursor.classList.add(options.class);'
          '  cursor.style.boxSizing = '#39'border-box'#39';'
          '  cursor.style.width = `${options.size}px`;'
          '  cursor.style.height = `${options.size}px`;'
          '  cursor.style.borderRadius = `${options.expandedSize}px`;'
          '  cursor.style.opacity = 0;'
          ''
          '  cursor.style.pointerEvents = '#39'none'#39';'
          '  cursor.style.zIndex = 999;'
          
            '  cursor.style.transition = `transform ${options.transitionTime}' +
            ' ${options.transitionEase}, width ${options.expandSpeed}s .2s, h' +
            'eight ${options.expandSpeed}s .2s, opacity 1s .2s`;'
          
            '  cursor.style.border = `${options.borderWidth}px solid ${option' +
            's.borderColor}`;'
          '  cursor.style.position = '#39'fixed'#39';'
          '  cursor.style.background = options.background;'
          ''
          '  cursor.appendChild(cursorIcon);'
          '  document.body.appendChild(cursor);'
          ''
          '  setTimeout(function () {'
          '    cursor.style.opacity = options.opacity;'
          '  }, 500);'
          ''
          '  var idle;'
          ''
          '  document.onmousemove = e => {'
          '    console.log('#39'test'#39');'
          '    x = e.pageX;'
          '    y = e.pageY;'
          ''
          '    cursor.style.opacity = options.opacity;'
          '    clearInterval(idle);'
          ''
          '    idle = setTimeout(function () {'
          '      cursor.style.opacity = 0;'
          '    }, 4000);'
          ''
          '    cursor.style.top = '#39'0'#39';'
          '    cursor.style.left = '#39'0'#39';'
          
            '    cursor.style.transform = `translateX(calc(${x}px - 50%)) tra' +
            'nslateY(calc(${y}px - 50%))`;'
          '  };'
          ''
          '  for (i in options.triggerElements) {'
          ''
          '    let trigger = $(`.${options.triggerElements[i].className}`);'
          ''
          '    console.log(trigger);'
          ''
          ''
          '    let icon = options.triggerElements[i].icon;'
          ''
          '    if (!trigger) {'
          '      console.warn('#39'You dont have any triggers'#39');'
          '    } else {'
          '      trigger.each(function (el) {'
          ''
          '        console.log();'
          '        trigger[el].style.cursor = '#39'default'#39';'
          '        trigger[el].addEventListener('#39'mouseover'#39', () => {'
          '          console.log('#39'over'#39');'
          '          cursor.style.width = `${options.expandedSize}px`;'
          '          cursor.style.height = `${options.expandedSize}px`;'
          '          cursorIcon.innerHTML = icon;'
          '          cursorIcon.style.opacity = 1;'
          ''
          ''
          '          console.log($(this));'
          ''
          ''
          '        });'
          ''
          '        trigger[el].addEventListener('#39'mouseout'#39', () => {'
          '          cursor.style.width = `${options.size}px`;'
          '          cursor.style.height = `${options.size}px`;'
          '          cursorIcon.style.opacity = 0;'
          '        });'
          '      });'
          ''
          '    }'
          '  }'
          '}'
          ''
          'dynamicCursor(cursorSettings);'
          ''
          '$('#39'.back'#39').click(function () {'
          '  $(this).parent().parent().removeClass('#39'expand'#39');'
          '});'
          '</script>')
        AutoScroll = True
        Align = alClient
        ScrollHeight = 500
        ScrollWidth = 857
      end
